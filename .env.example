# ==============================================================================
# Environment Configuration Template (Public Example)
# Copy this file to .env and configure your local paths and settings.
# NEVER commit the active .env file to GitHub!
# ==============================================================================

# Execution Environment
ENV=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8080

# Local Paths
PROFILE_DATA_PATH=data/profile.json
DB_PATH=storage/app.db
LOGS_DIR=logs/
APPLICATIONS_OUTPUT_DIR=output/applications/

# LaTeX Compilation
LATEX_CMD=pdflatex
LATEX_TEMPLATE_PATH=templates/cv_template.tex

# AI Providers (Optional - Used for semantic extraction and cover letters)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
