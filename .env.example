# ==============================================================================
# Variáveis de Ambiente do Sistema (Exemplo Público)
# Copie este arquivo para .env e preencha com seus caminhos e chaves locais.
# NUNCA comite o arquivo .env no GitHub!
# ==============================================================================

# Ambiente de Execução
ENV=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# Caminhos Locais
PROFILE_DATA_PATH=data/profile.json
DB_PATH=storage/app.db
LOGS_DIR=logs/
APPLICATIONS_OUTPUT_DIR=output/applications/

# Compilação LaTeX
LATEX_CMD=pdflatex
LATEX_TEMPLATE_PATH=templates/cv_template.tex

# Provedores de IA (Opcional - Usado para semantic extraction e LM)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
